        "# ============================================================\n",
        "# CELL 9  Visualising the Fitted CIR Model\n",
        "# ============================================================\n",
        "# This cell will create two plots:\n",
        "#   LEFT  : Possible future short-rate paths generated by the CIR model\n",
        "#   RIGHT : Yield curves produced by the model for different starting rates\n",
        "\n",
        "# -- Simulate 500 CIR paths for one year --\n",
        "def simulate_cir(kappa, theta, sigma, r0,\n",
        "                 n_steps=252,  #no of time steps\n",
        "                 n_paths=500,  #no of monte carlo paths\n",
        "                 dt=1/252):  #length of step\n",
        "    \"\"\"\n",
        "    Euler-Maruyama discretisation of the CIR SDE:\n",
        "        r_{t+dt} ≈ r_t + kappa*(theta - r_t)*dt + sigma*sqrt(r_t)*dW\n",
        "    where dW ~ N(0, sqrt(dt)).\n",
        "    \"\"\"\n",
        "    paths = np.zeros((n_steps + 1, n_paths))\n",
        "    paths[0] = r0                          #all paths start from today's rate\n",
        "    for t in range(n_steps):\n",
        "        r  = np.maximum(paths[t], 0)       #ensure we never pass a negative rate to sqrt\n",
        "        dW = np.random.randn(n_paths) * np.sqrt(dt)   #brownian increment\n",
        "        paths[t + 1] = r + kappa*(theta - r)*dt + sigma*np.sqrt(r)*dW  #approximation\n",
        "    return paths\n",
        "\n",
        "#Use the last observed 3M rate as the starting point\n",
        "r0_last = train[\"ZC025YR\"].iloc[-1]\n",
        "paths   = simulate_cir(cir_base.kappa, cir_base.theta, cir_base.sigma, r0_last)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
        "\n",
        "\n",
        "# --- Left: Simulated future short-rate paths ---\n",
        "# Show 50 sample paths out of 500 simulations\n",
        "axes[0].plot(paths[:, :50], linewidth=0.4, alpha=0.5)\n",
        "\n",
        "# Draw a line showing the long-term average rate\n",
        "axes[0].axhline(cir_base.theta, color=\"red\", linewidth=1.5,\n",
        "                linestyle=\"--\", label=f\"Long-term average rate θ = {cir_base.theta*100:.2f}%\")\n",
        "\n",
        "axes[0].set_title(f\"Possible Future Interest Rate Paths (50 of 500 shown, starting rate = {r0_last*100:.2f}%)\")\n",
        "axes[0].set_ylabel(\"Interest Rate (%)\")\n",
        "axes[0].yaxis.set_major_formatter(plt.FuncFormatter(lambda x, _: f\"{x*100:.1f}%\"))\n",
        "axes[0].set_xlabel(\"Trading Days\")\n",
        "axes[0].legend()\n",
        "\n",
        "# --- Right: Yield curves for different starting rates ---\n",
        "# This shows how the yield curve changes when the starting short rate changes\n",
        "taus_plot = np.linspace(0.1, 30, 200)\n",
        "\n",
        "for r0_val, label in [(0.005, \"r₀ = 0.5% (bery low)\"),\n",
        "                       (0.02,  \"r₀ = 2.0%\"),\n",
        "                       (0.035, \"r₀ = 3.5%\"),\n",
        "                       (0.05,  \"r₀ = 5.0% (high)\")]:\n",
        "    y = cir_base.yield_curve(taus_plot, r0_val)\n",
        "    axes[1].plot(taus_plot, y * 100, linewidth=1.5, label=label)\n",
        "\n",
        "#Draw a line showing the long-term average rate\n",
        "axes[1].axhline(cir_base.theta * 100, color=\"black\", linewidth=1,\n",
        "                linestyle=\":\", label=f\"θ = {cir_base.theta*100:.2f}% (long-term average rate)\")\n",
        "\n",
        "axes[1].set_title(\"Yield Curves for Different Starting Rates\")\n",
        "axes[1].set_xlabel(\"Time to Maturity (Years)\")\n",
        "axes[1].set_ylabel(\"Yield (%)\")\n",
        "axes[1].legend(fontsize=8)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"02_cir_simulation.png\", bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nObservation:\")\n",
        "print(\"  If the starting rate r₀ is lower than θ, yields usually rise as maturity increases.\")\n",
        "print(\"  If the starting rate r₀ is higher than θ, yields usually fall as maturity increases.\")\n",
        "print(\"  Over very long maturities, all curves move toward θ (the long-term average rate).\")\n"
