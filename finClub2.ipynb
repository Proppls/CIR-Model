        "# ============================================================\n",
        "# CELL 10b · Prediction and Testing\n",
        "# ============================================================\n",
        "\n",
        "def invert_short_rate(y_3m_obs: np.ndarray,\n",
        "                      model: CIRModel,\n",
        "                      tau3m: float = 0.25) -> np.ndarray:\n",
        "    \"\"\"\n",
        "    Estimate the hidden short-term interest rate (r_t)\n",
        "    using the observed 3-month yield.\n",
        "\n",
        "    We rearrange the CIR yield formula:\n",
        "        y(tau) = [B(tau)*r_t - ln_A(tau)] / tau\n",
        "    to get:\n",
        "        r_t = [y*tau + ln_A(tau)] / B(tau)\n",
        "    \"\"\"\n",
        "    tau_arr = np.array([tau3m])\n",
        "\n",
        "    #Calculate B and ln(A) for a 3-month maturity\n",
        "    B3m   = model.B(tau_arr, model.kappa, model.sigma)[0]\n",
        "    lnA3m = model.ln_A(tau_arr, model.kappa, model.theta, model.sigma)[0]\n",
        "\n",
        "    #Calculate the short rate for every test date\n",
        "    r_t = (y_3m_obs*tau3m + lnA3m)/B3m\n",
        "    return r_t\n",
        "\n",
        "\n",
        "def evaluate_model(model: CIRModel,\n",
        "                   test3m_df: pd.DataFrame,\n",
        "                   test_df: pd.DataFrame,\n",
        "                   label: str = \"Model\") -> dict:\n",
        "    \"\"\"\n",
        "    Test how well the model works.\n",
        "    Steps:\n",
        "      1. Estimate the short rate from the 3M yield\n",
        "      2. Predict the remaining yields\n",
        "      3. Compare predictions with actual market values\n",
        "      4. Calculate accuracy measures\n",
        "    \"\"\"\n",
        "\n",
        "    # Step 1: Estimate short rate from 3M yield\n",
        "    r0 = invert_short_rate(test3m_df[\"ZC025YR\"].values, model)\n",
        "\n",
        "    # Step 2: Predict 6M, 9M, 1Y and 2Y yields\n",
        "    y_pred   = model.yield_curve(TAUS_PREDICT, r0)      # predicted yields\n",
        "    y_actual = test_df[PREDICT_COLS].values             # actual yields\n",
        "\n",
        "    # Step 3: Calculate performance measures\n",
        "    metrics = {}\n",
        "\n",
        "    for i, col in enumerate(PREDICT_COLS):\n",
        "        metrics[col] = {\n",
        "            \"r2\"  : r2_score(y_actual[:, i], y_pred[:, i]),\n",
        "            \"rmse\": np.sqrt(np.mean((y_actual[:, i] - y_pred[:, i])**2)),\n",
        "            \"bias\": np.mean(y_pred[:, i] - y_actual[:, i]),\n",
        "        }\n",
        "\n",
        "    #overall R2 using all predictions together\n",
        "    metrics[\"overall_r2\"] = r2_score(y_actual.flatten(), y_pred.flatten())\n",
        "\n",
        "    print(f\"\\n{'─'*55}\")\n",
        "    print(f\"  {label}\")\n",
        "    print(f\"{'─'*55}\")\n",
        "    print(f\"  {'Maturity':6s}  {'R²':>8s}  {'RMSE (bps)':>12s}  {'Bias (bps)':>12s}\")\n",
        "    print(\"\\n\")\n",
        "\n",
        "    for col in PREDICT_COLS:\n",
        "        tau_label = f\"{TENOR_MAP[col]:.2f}Y\"\n",
        "        m = metrics[col]\n",
        "        print(\n",
        "            f\"  {tau_label:6s}  \"\n",
        "            f\"{m['r2']:8.4f}  \"\n",
        "            f\"{m['rmse']*10000:12.1f}  \"\n",
        "            f\"{m['bias']*10000:+12.1f}\"\n",
        "        )\n",
        "    print(\n",
        "        f\"  Overall R2 = {metrics['overall_r2']:.4f}   \"\n",
        "        f\"(Target > 0.85: {'PASS' if metrics['overall_r2'] > 0.85 else 'FAIL'})\"\n",
        "    )\n",
        "    return {\n",
        "        \"y_pred\": y_pred,\n",
        "        \"y_actual\": y_actual,\n",
        "        \"metrics\": metrics,\n",
        "        \"r0\": r0\n",
        "    }\n",
        "\n",
        "\n",
        "# -- Testing the model on the test data --\n",
        "results_base = evaluate_model(\n",
        "    cir_base,\n",
        "    test3m,\n",
        "    test,\n",
        "    \"Base CIR Model\"\n",
        ")\n",
        "\n",
        "# -- Plot actual yields and model predictions over time --\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 8))\n",
        "axes = axes.flatten()\n",
        "\n",
        "# Dates for the x-axis\n",
        "dates = test[\"Date\"].values\n",
        "\n",
        "for i, (col, ax) in enumerate(zip(PREDICT_COLS, axes)):\n",
        "    tau_label = f\"{TENOR_MAP[col]:.2f}Y\"\n",
        "    # Actual market yields\n",
        "    ax.plot(\n",
        "        dates,\n",
        "        results_base[\"y_actual\"][:, i] * 100,\n",
        "        label=\"Actual Yield\",\n",
        "        linewidth=1.0,\n",
        "        color=\"black\"\n",
        "    )\n",
        "    #CIR model predictions\n",
        "    ax.plot(\n",
        "        dates,\n",
