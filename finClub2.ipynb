        "TENOR_MAP = {\n",
        "    \"ZC025YR\": 0.25,   #3-month\n",
        "    \"ZC050YR\": 0.50,   #6-month\n",
        "    \"ZC075YR\": 0.75,   #9-month\n",
        "    \"ZC100YR\": 1.00,   #1-year\n",
        "    \"ZC200YR\": 2.00,   #2-year\n",
        "    \"ZC500YR\": 5.00,   #5-year\n",
        "    \"ZC1000YR\": 10.00, #10-year\n",
        "    \"ZC2000YR\": 20.00, #20-year\n",
        "    \"ZC3000YR\": 30.00, #30-year\n",
