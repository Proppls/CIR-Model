        "# ============================================================\n",
        "# CELL 4 · Data Preprocessing\n",
        "# ============================================================\n",
        "#This cell focuses on fixing these problems:\n",
        "#  • Missing values on holidays (markets are closed)\n",
        "#  • Occasional duplicate dates (data errors)\n",
        "#  • Extreme outliers (data spikes or mis-entries)\n",
        "\n",
        "class YieldCurvePreprocessor:\n",
        "    \"\"\"\n",
        "    This class cleans the yield-curve data in 5 steps:\n",
        "      1. Change text values into numbers\n",
        "      2. Remove repeated dates\n",
        "      3. Add missing business days and fill small gaps\n",
        "      4. Limit extremely large or small values\n",
        "      5. Check if any interest rates are still zero or negative\n",
        "\n",
        "    These steps help make the data more reliable for modelling.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, max_ffill_days: int = 5, winsor_pct: float = 0.01):\n",
        "        # max_ffill_days: Maximum number of missing days that can be filled\n",
        "        #winsor_pct: %age used to limit extreme values (0.01= 1% each tail)\n",
        "        self.max_ffill = max_ffill_days\n",
        "        self.winsor    = winsor_pct\n",
        "        self.stats_    = {}\n",
        "        #stores (low, high) bounds learned from training data\n",
        "\n",
        "    def fit_transform(self, df: pd.DataFrame, tenor_cols: list) -> pd.DataFrame:\n",
        "        #Learns cleaning rules from df then apply them.uses on training data.\n",
        "        df = df.copy()\n",
        "\n",
        "        #Step-1: forcing all tenor columns to be numeric (coerce bad values to NaN)\n",
        "        for col in tenor_cols:\n",
        "            df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "\n",
        "        #Step 2: drop duplicate dates (only keep the last occurrence)\n",
        "        n_dup = df[\"Date\"].duplicated().sum()\n",
        "        if n_dup:\n",
        "            print(f\"  Removing {n_dup} duplicate date(s)\")\n",
        "            df = df.drop_duplicates(subset=\"Date\", keep=\"last\")\n",
        "            #keeping last as its most recent\n",
        "        else:\n",
        "            print(\"  No duplicate dates found\")\n",
        "\n",
        "        #Step 3: re-index to every business day in the date range\n",
        "        #This inserts NaN rows for holidays, then forward-fills up to max_ffill days\n",
        "        bday_idx = pd.bdate_range(df[\"Date\"].min(), df[\"Date\"].max())\n",
        "        # print(bday_idx)\n",
        "        df = df.set_index(\"Date\").reindex(bday_idx)\n",
        "        missing_dates = df.index[df.isna().all(axis=1)]\n",
        "        print(len(missing_dates), \"missing date(s)\\n\")\n",
        "        #There was no missing date in this dataset\n",
        "        # print(missing_dates)\n",
        "        df.index.name = \"Date\"\n",
        "        df = df.fillna(method=\"ffill\", limit=self.max_ffill)  #fill short gaps only\n",
        "        df = df.dropna(subset=tenor_cols)                     #drop remaining NaN rows\n",
        "        df = df.reset_index()\n",
        "        #n_filled = len(bday_idx) - len(df)\n",
        "        #there was no missing dates so n_filled = 0\n",
        "        # print(n_filled)\n",
        "\n",
        "\n",
        "        #Step-4: winsorise values\n",
        "        for col in tenor_cols:\n",
        "            lo = df[col].quantile(self.winsor)       #1st percentile\n",
        "            hi = df[col].quantile(1 - self.winsor)   #99th percentile\n",
        "            self.stats_[col] = (lo, hi)              #saving bounds for future use\n",
        "            n_out = ((df[col] < lo) | (df[col] > hi)).sum() #outlier count\n",
        "            if n_out:\n",
        "                print(f\"  {col}: clipping {n_out} outlier(s) to [{lo:.5f}, {hi:.5f}]\")\n",
        "            df[col] = df[col].clip(lo, hi)\n",
        "\n",
        "        #Step-5: checking for non-positive yields (real bond are usually +ve)\n",
        "        neg = (df[tenor_cols] <= 0).any(axis=1).sum()\n",
        "        #Feller condition help preserve positive rates\n",
        "        if neg:\n",
        "            print(f\"  WARNING: {neg} rows with non-positive yields detected\")\n",
        "        else:\n",
        "            print(\"\\nNo rows with non-positive yields detected \\n\")\n",
        "\n",
        "        print(f\"    Preprocessed → {len(df):,} rows\")\n",
        "        return df\n",
        "\n",
        "    def transform(self, df: pd.DataFrame, tenor_cols: list) -> pd.DataFrame:\n",
        "        \"\"\"Apply the same clipping rules learned from training\"\"\"\n",
        "        df = df.copy()\n",
        "        for col in tenor_cols:\n",
        "            if col in self.stats_:\n",
        "                lo, hi = self.stats_[col]\n",
        "                df[col] = pd.to_numeric(df[col], errors=\"coerce\").clip(lo, hi)\n",
        "        return df.dropna(subset=tenor_cols).reset_index(drop=True)\n",
        "\n",
        "\n",
        "#----- Apply preprocessing ---------------------------------\n",
        "print(\"-- Training set ---\")\n",
        "prep  = YieldCurvePreprocessor()\n",
        "train = prep.fit_transform(train, TRAIN_COLS)  #learn cleaning settings + clean train data\n",
        "\n",
        "print(\"\\n-- Test set --\")\n",
        "test   = prep.transform(test,   TEST_COLS)     #uses same cleaning settings on test data\n",
        "test3m = prep.transform(test3m, [\"ZC025YR\"])\n",
        "\n",
        "#---- Viewing the cleaned data ----------------------------\n",
        "print(\"\\n--- First 5 rows of cleaned train data ---\")\n",
        "print(train[[\"Date\"] + TRAIN_COLS].head())\n",
        "print(\"\\nColumn data types:\")\n",
        "print(train[TRAIN_COLS].dtypes)\n",
        "print(\"\\nSummary of training yields (%) :\")\n",
        "print((train[TRAIN_COLS] * 100).describe().round(3))\n"
      ]
