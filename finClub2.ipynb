        "    subsample  = 5,\n",
        "    verbose    = True,\n",
        ")\n",
        "\n",
        "# Use the last 1-year average from training as the fixed level factor\n",
        "x_anchor = train[\"ZC025YR\"].iloc[-WINDOW:].mean()\n",
        "\n",
        "# Observed 3M yields in the test period\n",
        "test_r0_obs = test3m[\"ZC025YR\"].values\n",
