        "# ============================================================\n",
        "# CELL-11b  Sanity Check: Step-by-Step Manual Prediction\n",
        "# ============================================================\n",
        "# Goal: Verify the model calculations by manually predicting step by step.\n",
        "\n",
        "#First test date\n",
        "check_idx = 0\n",
        "check_date = test[\"Date\"].iloc[check_idx]\n",
        "\n",
        "print(\"=\" * 55)\n",
        "print(f\"Sanity Check for {check_date.date()}\")\n",
        "print(\"=\" * 55)\n",
        "\n",
        "# Step 1: Observe the 3M yield\n",
        "y_3m_obs = test3m[\"ZC025YR\"].iloc[check_idx]\n",
        "print(f\"\\nStep 1: Observed 3M yield = {y_3m_obs*100:.4f}%\")\n",
        "\n",
        "# Step 2: Get fitted CIR parameters\n",
        "k = cir_base.kappa\n",
        "th = cir_base.theta\n",
        "sg = cir_base.sigma\n",
        "\n",
        "print(\"\\nStep 2: Model Parameters\")\n",
        "print(f\"  kappa = {k:.6f}\")\n",
        "print(f\"  theta = {th:.6f} ({th*100:.4f}%)\")\n",
        "print(f\"  sigma = {sg:.2e}\")\n",
        "\n",
        "# Step 3: Compute gamma\n",
        "gamma = np.sqrt(k**2 + 2 * sg**2)\n",
        "\n",
        "print(\"\\nStep 3: Compute gamma\")\n",
        "print(f\"  gamma = sqrt(kappa^2 + 2*sigma^2)\")\n",
        "print(f\"  gamma = {gamma:.6f}\")\n",
        "\n",
        "# Step-4: Compute B(0.25)\n",
        "tau_3m = 0.25\n",
        "exp_g_tau = np.exp(gamma * tau_3m)\n",
        "\n",
        "B_3m = 2 * (exp_g_tau - 1) / (\n",
        "    (gamma + k) * (exp_g_tau - 1) + 2 * gamma\n",
        ")\n",
        "\n",
        "print(\"\\nStep 4: Compute B(0.25)\")\n",
        "print(f\"  exp(gamma*tau) = {exp_g_tau:.6f}\")\n",
        "print(f\"  B(0.25) = {B_3m:.6f}\")\n",
        "\n",
        "# Step 5: Compute ln(A)\n",
        "num_A = 2 * gamma * np.exp((k + gamma) * tau_3m / 2)\n",
        "denom_A = (gamma + k) * (exp_g_tau - 1) + 2 * gamma\n",
        "\n",
        "lnA_3m = (2 * k * th / sg**2) * np.log(num_A / denom_A)\n",
        "\n",
        "print(\"\\nStep 5: Compute ln(A)\")\n",
        "print(f\"  numerator   = {num_A:.6f}\")\n",
        "print(f\"  denominator = {denom_A:.6f}\")\n",
        "print(f\"  ln(A)       = {lnA_3m:.6f}\")\n",
        "\n",
        "# Step 6: Recover short rate\n",
        "r_t_manual = (y_3m_obs * tau_3m + lnA_3m) / B_3m\n",
        "\n",
        "print(\"\\nStep 6: Recover short rate r_t\")\n",
        "print(\"  r_t = (y*tau + lnA) / B\")\n",
        "print(f\"  r_t = {r_t_manual:.6f} ({r_t_manual*100:.4f}%)\")\n",
        "\n",
        "# Step 7: Predict 1Y yield\n",
        "tau_1y = 1.0\n",
        "\n",
        "exp_g_1y = np.exp(gamma * tau_1y)\n",
        "\n",
        "B_1y = 2 * (exp_g_1y - 1) / (\n",
        "    (gamma + k) * (exp_g_1y - 1) + 2 * gamma\n",
        ")\n",
        "\n",
        "num_A1y = 2 * gamma * np.exp((k + gamma) * tau_1y / 2)\n",
        "den_A1y = (gamma + k) * (exp_g_1y - 1) + 2 * gamma\n",
        "\n",
        "lnA_1y = (2 * k * th / sg**2) * np.log(num_A1y / den_A1y)\n",
        "\n",
        "y_1y_pred_manual = (B_1y * r_t_manual - lnA_1y) / tau_1y\n",
        "\n",
        "print(\"\\nStep 7: Predict 1-Year Yield\")\n",
        "print(f\"  B(1.0) = {B_1y:.6f}\")\n",
        "print(f\"  ln(A)  = {lnA_1y:.6f}\")\n",
        "print(f\"  Predicted 1Y yield = {y_1y_pred_manual*100:.4f}%\")\n",
        "\n",
