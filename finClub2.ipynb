      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# CELL 12b · Two-Factor CIR Extension\n",
        "# ============================================================\n",
        "print(\"=\" * 60)\n",
        "print(\"Two-Factor CIR Model\")\n",
        "print(\"=\" * 60)\n",
        "print(\"\"\"\n",
        "Why use two factors?\n",
        "The one-factor CIR model can mainly shift the entire yield curve up or down.\n",
        "However, it cannot easily capture changes in the shape of the curve.\n",
        "\n",
        "To improve this, we split the short rate into two parts:\n",
        "    r_t = x_t + z_t\n",
        "where:\n",
        "    x_t = long-term level component\n",
        "    z_t = short-term deviation component\n",
        "\n",
        "Both components follow their own CIR process with separate\n",
        "kappa, theta and sigma parameters.\n",
        "\"\"\")\n",
        "\n",
        "class TwoFactorCIR:\n",
        "    \"\"\"\n",
        "    Longstaff-Schwartz two-factor CIR model\n",
        "\n",
        "    Short-term interest rate:\n",
        "        r_t = x_t + z_t\n",
        "    where:\n",
        "        x_t = level factor (overall rate level)\n",
        "        z_t = slope factor (difference from the trend)\n",
        "\n",
        "    Bond price is the product of the prices from both factors\n",
        "    Total yield = yield from x factor + yield from z factor.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        self.params_x = None   # (kappa_x, theta_x, sigma_x)\n",
        "        self.params_z = None   # (kappa_z, theta_z, sigma_z)\n",
        "\n",
        "    @staticmethod\n",
        "    def _cir_yield_component(taus, factor_val, kappa, theta, sigma):\n",
        "        \"\"\"\n",
        "        Calculate the yield contribution from one CIR factor.\n",
        "        \"\"\"\n",
        "        g = np.sqrt(kappa**2 + 2 * sigma**2)   #gamma term used in CIR formulas\n",
        "        B = 2* (np.exp(g * taus) - 1)/ (\n",
        "            (g + kappa) * (np.exp(g * taus) - 1) + 2 * g\n",
        "        )\n",
        "\n",
        "        numer = 2 * g * np.exp((kappa + g) * taus / 2)\n",
        "        denom = (g + kappa) * (np.exp(g * taus) - 1) + 2 * g\n",
        "\n",
        "        lnA = (2 * kappa * theta / sigma**2) * np.log(numer / denom)\n",
        "\n",
        "        # Single factor\n",
        "        if np.ndim(factor_val) == 0:\n",
        "            return (B * float(factor_val) - lnA) / taus\n",
        "\n",
        "        # multiple factor values at once\n",
        "        else:\n",
        "            fv = np.asarray(factor_val)\n",
        "            return (np.outer(fv, B) - lnA[None, :]) / taus[None, :]\n",
        "\n",
        "    def yield_curve(self, taus, x_arr, z_arr):\n",
        "        \"\"\"\n",
        "        Calculate the complete yield curve using both factors.\n",
        "        \"\"\"\n",
        "        kx, thx, sgx = self.params_x\n",
        "        kz, thz, sgz = self.params_z\n",
        "\n",
        "        return (\n",
        "            self._cir_yield_component(taus, x_arr, kx, thx, sgx) +  # contribution from level factor\n",
        "            self._cir_yield_component(taus, z_arr, kz, thz, sgz)    # contribution from slope factor\n",
        "        )\n",
        "\n",
        "    def fit(self, x_arr, z_arr, yields_arr, taus, subsample=5, verbose=True):\n",
        "\n",
        "        # Use every nth row to make calibration faster\n",
        "        idx = np.arange(0, len(x_arr), subsample)\n",
        "        x_s, z_s, y_s = x_arr[idx], z_arr[idx], yields_arr[idx]\n",
        "\n",
        "        def loss(params):\n",
        "            \"\"\"\n",
        "            Calculate prediction error for a given parameter set.\n",
        "\n",
        "            Lower loss means the model matches market yields better.\n",
        "            \"\"\"\n",
        "            kx, thx, sgx, kz, thz, sgz = params\n",
        "\n",
        "            #we reject invalid parameter values\n",
        "            if any(p <= 0 for p in params):\n",
        "                return 1e10\n",
        "\n",
        "            try:\n",
        "                yp = (\n",
        "                    self._cir_yield_component(taus, x_s, kx, thx, sgx)\n",
        "                    + self._cir_yield_component(taus, z_s, kz, thz, sgz)\n",
        "                )\n",
        "\n",
        "                #also reject NaN or infinite values\n",
        "                if not np.all(np.isfinite(yp)):\n",
        "                    return 1e10\n",
        "\n",
        "                # Mean Squared Error(mse)\n",
        "                return float(np.mean((yp - y_s) ** 2))\n",
        "\n",
        "            except Exception:\n",
        "                return 1e10\n",
        "\n",
        "        # Starting values if grid search fails\n",
        "        best_loss = 1e10\n",
        "        best_x0 = [0.2, 0.02, 1e-5, 0.5, 0.005, 1e-5]\n",
        "\n",
        "        # Try different parameter combinations to find a good starting point\n",
        "        for kx in [0.1, 0.3]:\n",
        "            for thx in [0.015, 0.025]:\n",
        "                for kz in [0.3, 1.0, 3.0]:\n",
        "                    for thz in [0.001, 0.005]:\n",
        "\n",
        "                        x0 = [kx, thx, 1e-7, kz, thz, 1e-7]\n",
        "\n",
        "                        lv = loss(x0)\n",
        "\n",
        "                        if lv < best_loss:\n",
        "                            best_loss = lv\n",
        "                            best_x0 = x0\n",
        "\n",
        "        # Fine-tune parameters using Nelder-Mead optimisation\n",
        "        res = minimize(\n",
        "            loss,\n",
        "            best_x0,\n",
        "            method=\"Nelder-Mead\",\n",
        "            options={\n",
        "                \"maxiter\": 30_000,  # maximum optimisation steps\n",
        "                \"xatol\": 1e-11,     # parameter tolerance\n",
        "                \"fatol\": 1e-13      # loss tolerance\n",
        "            }\n",
        "        )\n",
        "\n",
        "        kx, thx, sgx, kz, thz, sgz = res.x\n",
        "\n",
        "        self.params_x = (kx, thx, sgx)\n",
        "        self.params_z = (kz, thz, sgz)\n",
        "\n",
        "        if verbose:\n",
        "            print(f\"Level factor (x): κ={kx:.5f}, θ={thx:.6f}, σ={sgx:.2e}\")\n",
        "            print(f\"Slope factor (z): κ={kz:.5f}, θ={thz:.6f}, σ={sgz:.2e}\")\n",
        "\n",
        "            print(\n",
        "                f\"Feller condition - x factor: {2*kx*thx >= sgx**2}, \"\n",
        "                f\"z factor: {2*kz*thz >= sgz**2}\"\n",
        "            )\n",
        "\n",
        "        return self\n",
        "\n"
      ],
