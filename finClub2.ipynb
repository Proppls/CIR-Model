        "# ============================================================\n",
        "# CELL 8b · Run Calibration\n",
        "# ============================================================\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"Teaining base CIR (Cross-Sectional GMM)\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "cir_base = CIRModel()   #new model\n",
        "cir_base.fit(\n",
        "    r0_arr     = train[\"ZC025YR\"].values,    # 3M yield used as proxy for short rate\n",
