      "source": [
        "# ============================================================\n",
        "# CELL 7 · CIR Model Class\n",
        "# ============================================================\n",
        "#This class contains all the formulas used in the CIR model\n",
        "#It helps us calculate bond prices, yields, and model parameters\n",
        "\n",
        "class CIRModel:\n",
        "    \"\"\"\n",
        "    Implements the Cox–Ingersoll–Ross (1985) short-rate model.\n",
        "    After calling .fit(), the model stores:\n",
        "      self.kappa  – speed of mean reversion\n",
        "      self.theta  – long-run mean rate\n",
        "      self.sigma  – randomness in interest-rate movements\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        #parameters are None until .fit() is called\n",
        "        self.kappa = self.theta = self.sigma = None\n",
        "        self.gamma_ = self.feller_ = None\n",
        "\n",
        "    #-----Step 1: Compute gamma = sqrt(kappa^2 + 2*sigma^2)--------------\n",
        "    @staticmethod     #static so it depends on input only\n",
        "    def _gamma(kappa: float, sigma: float) -> float:\n",
        "        \"\"\"Helper value used in the CIR formulas\"\"\"\n",
        "        return np.sqrt(kappa**2 + 2 * sigma**2)   #introducing gamma to make formulae look cleaner\n",
        "\n",
        "\n",
        "    #-----Step 2: Compute B(tau)--------------------------\n",
        "    @staticmethod\n",
        "    def B(tau: np.ndarray, kappa: float, sigma: float) -> np.ndarray:\n",
        "        \"\"\"\n",
        "        B(tau) is the coefficient on r_t in the yield formula\n",
        "        Larger B means the short rate has more influence on yield at that maturity\n",
        "        \"\"\"\n",
        "        g = CIRModel._gamma(kappa, sigma)\n",
        "        numerator   = 2*(np.exp(g*tau)-1)\n",
        "        denominator = (g + kappa)*(np.exp(g * tau) - 1) + 2*g\n",
        "        return numerator/denominator\n",
        "\n",
        "\n",
        "    #---Step-3: Computing ln(A(tau))----------------------\n",
        "    @staticmethod    #working with ln_A instead of A to avoid overflow\n",
        "    def ln_A(tau: np.ndarray, kappa: float, theta: float, sigma: float) -> np.ndarray:\n",
        "        \"\"\"\n",
        "        ln(A(tau)) is the maturity-dependent intercept in the yield formula\n",
        "        It captures how much the long-run mean theta 'bends' the yield curve\n",
        "        \"\"\"\n",
        "        g = CIRModel._gamma(kappa, sigma)\n",
        "        num   = 2*g*np.exp((kappa + g)*tau/2)\n",
        "        denom = (g + kappa) * (np.exp(g*tau)-1) + 2*g\n",
        "        return (2*kappa*theta / sigma**2) * np.log(num/denom)\n",
        "\n",
        "\n",
        "    #---Step-4: Compute the full yield curve-------------------\n",
        "    def yield_curve(self, taus, r0, kappa=None, theta=None, sigma=None):\n",
        "        \"\"\"\n",
        "        Calculates the model yield curve using a given short rate r0.\n",
        "\n",
        "        Input:\n",
        "          taus = list of maturities (e.g. 0.25Y, 0.5Y, 1Y, ...)\n",
        "          r0   = current short rate\n",
        "        Formula:\n",
        "          y(tau) = [B(tau) * r0 - ln(A(tau))] / tau\n",
        "        \"\"\"\n",
        "        #use fitted parameters unless overrides are provided\n",
        "        k  = kappa if kappa is not None else self.kappa\n",
        "        th = theta if theta is not None else self.theta\n",
        "        sg = sigma if sigma is not None else self.sigma\n",
        "\n",
        "        B   = self.B(tau=taus, kappa=k, sigma=sg)         # shape: (n_tenors,)\n",
        "        lnA = self.ln_A(tau=taus, kappa=k, theta=th, sigma=sg)\n",
        "\n",
        "        #single rate case vs multiple rate case\n",
        "        if np.ndim(r0) == 0:\n",
        "            #Single short rate --> return a 1D array of yields\n",
        "            return (B * float(r0) - lnA) / taus\n",
        "        else:\n",
        "            #Array of short rates -> return a 2D array (n_dates, n_tenors)\n",
        "            r0 = np.asarray(r0)\n",
        "            return (np.outer(r0, B) - lnA[None, :]) / taus[None, :]\n",
        "            #vectorised much faster than double for loops\n",
        "\n",
        "\n",
        "    #-- Step 5: Calibration --------------\n",
        "    def fit(self, r0_arr, yields_arr, taus, subsample=5, verbose=True):\n",
        "        \"\"\"\n",
        "        Find kappa, theta, sigma that best explain the observed yield curves.\n",
        "\n",
        "         Method:\n",
        "          Stage 1 — Grid Search\n",
        "          Try many combinations of kappa, theta, and sigma.\n",
        "          This helps find a good starting point.\n",
        "\n",
        "          Stage 2 — Nelder-Mead Optimisation\n",
        "          Starting from the best grid-search result, fine-tune\n",
        "          the parameters to get an even better fit.\n",
        "\n",
        "        Loss function: Mean Squared Error (MSE) between model yields and actual yields,\n",
        "          averaged over a subsample of training dates and all maturities.\n",
        "        \"\"\"\n",
        "        #Use every 5th training row to speed up calibration\n",
        "        # similar results it runs ~5x faster\n",
        "        idx  = np.arange(0, len(r0_arr), subsample)\n",
        "        r0_s = r0_arr[idx]      #subsampled short rates\n",
        "        y_s  = yields_arr[idx]  # subsampled observed yields\n",
        "\n",
        "        def loss(params):\n",
        "            \"\"\"\n",
        "            Calculates how well a set of parameters fits the data.\n",
        "            Input:\n",
        "              params = [kappa, theta, sigma]\n",
        "            Output:\n",
        "              MSE value\n",
        "\n",
        "            Smaller MSE means the model matches the market data better.\n",
        "            Invalid parameter values receive a very large penalty\n",
        "            so the optimiser avoids them.\n",
        "            \"\"\"\n",
        "            k, th, sg = params\n",
        "\n",
        "            #interest rate parameters must be positive\n",
        "            if k <= 0 or th <= 0 or sg <= 0:\n",
        "                return 1e10\n",
        "            try:\n",
        "                #computing what the model Predicts for each date in the subsample\n",
        "                y_pred = self.yield_curve(taus, r0_s, k, th, sg)  # shape: (no of dates, no of tenors)\n",
        "\n",
        "                #If any result is NaN or Inf, the params caused a numerical error so reject\n",
        "                if np.any(~np.isfinite(y_pred)):\n",
        "                    return 1e10\n",
        "\n",
        "                #MSE = average squared difference between model yield and actual yield\n",
        "                #Lower MSE = better fit\n",
        "                mse = float(np.mean((y_pred - y_s)**2))\n",
        "                return mse\n",
        "            except Exception:\n",
        "                return 1e10   #something went wrong ---> treat as worst-case loss\n",
        "\n",
        "\n",
        "        #----Stage 1: Coarse grid search ----------\n",
        "        #We try all combinations of kappa, theta, sigma from these candidate lists\n",
        "        #Total combinations: 6 × 6 × 4 = 144 evaluations\n",
        "        best_loss= 1e10\n",
        "        best_x0   =[0.5, 0.025, 1e-5]   #starting point\n",
        "\n",
        "        for k in [0.05, 0.1, 0.2, 0.3, 0.5, 1.0]:\n",
        "            for th in [0.010, 0.015, 0.020, 0.025, 0.030, 0.040]:\n",
        "                for sg in [1e-7, 1e-4, 0.01, 0.05]:\n",
        "                    lv = loss([k, th, sg])    #calcualtes error for this combo\n",
        "                    if lv < best_loss:        #keeping track of best combination\n",
        "                        best_loss, best_x0 = lv, [k, th, sg]\n",
        "\n",
        "        if verbose:\n",
        "            print(\n",
        "                f\"  Best values from grid search → \"\n",
        "                f\"κ={best_x0[0]:.4f}, θ={best_x0[1]:.5f}, \"\n",
        "                f\"σ={best_x0[2]:.2e}  (loss={best_loss:.2e})\"\n",
        "            )\n",
        "\n",
        "\n",
        "        # -- Stage 2: Nelder-Mead refinement ----------\n",
        "        #Started from the grid best and improve it further using Nelder mead\n",
        "        #doestn require derivtives and works best on noisy func\n",
        "        res = minimize(\n",
        "            loss, best_x0,\n",
        "            method=\"Nelder-Mead\",\n",
        "            options={\"maxiter\": 30_000,    #max iterations: 30k\n",
        "                     \"xatol\": 1e-12,       #parameter tolerance\n",
        "                     \"fatol\": 1e-14},      #fn value tolerance\n",
        "        )\n",
        "\n",
        "        #Store the final calibrated parameters\n",
        "        self.kappa = res.x[0]\n",
        "        self.theta = res.x[1]\n",
        "        self.sigma = res.x[2]\n",
        "        self.gamma_  = self._gamma(self.kappa, self.sigma)   #calculating gamma for future purposes\n",
        "        self.feller_ = (2 * self.kappa * self.theta >= self.sigma ** 2)    #checking for feller condn\n",
        "\n",
        "        if verbose:\n",
        "            print(\n",
        "                f\"  Final fitted values -> \"\n",
        "                f\"κ={self.kappa:.5f}, \"\n",
        "                f\"θ={self.theta:.6f}, \"\n",
        "                f\"σ={self.sigma:.2e}\"\n",
        "            )\n",
        "            print(\n",
        "                f\"  Feller condition (2κθ ≥ σ²): {self.feller_}  \"\n",
        "                f\"(2κθ={2*self.kappa*self.theta:.6f}, \"\n",
        "                f\"σ²={self.sigma**2:.2e})\"\n",
        "            )\n",
        "\n",
        "        return self   # return self so we can chain calls: model.fit(...).yield_curve(...)\n",
        "\n",
        "\n",
        "    # --- MLE alternative (for comparison) ---------\n",
        "    def mle_fit(self, r, dt=1/252, verbose=True):\n",
        "        \"\"\"\n",
        "        Estimates kappa, theta, and sigma using the time-series\n",
        "        behaviour of short rates.\n",
        "\n",
        "        Unlike the main calibration method, which focuses on matching\n",
        "        yield curves, MLE focuses on matching how interest rates move\n",
        "        from one day to the next.\n",
        "\n",
        "        Key idea:\n",
        "          Given today's rate (r_t), the CIR model provides the exact\n",
        "          probability distribution of tomorrow's rate (r_t+dt).\n",
        "          MLE finds the parameter values that make the observed\n",
        "          historical rate movements most likely.\n",
        "\n",
        "        In practice:\n",
        "          • MLE usually captures short-rate volatility better.\n",
        "          • It often produces a larger sigma value.\n",
        "          • It may give lower yield-curve accuracy (lower R²).\n",
        "\n",
        "        This highlights the trade-off between:\n",
        "          1. Fitting yield curves well (cross-sectional fit)\n",
        "          2. Fitting rate movements well (time-series fit)\n",
        "        \"\"\"\n",
        "        r_t  = r[:-1]   #today's rate\n",
        "        r_t1 = r[1:]    #tomorrow's rate\n",
        "\n",
        "        def neg_ll(params):\n",
        "            k, th, sg = params\n",
        "            #rejecting non-postiive params immediately (not useful)\n",
        "            if k<= 0 or th<= 0 or sg<= 0:\n",
        "                return 1e10\n",
        "            try:\n",
        "                c = 2*k / (sg**2 *(1 - np.exp(-k * dt)))  #scaling const.\n",
        "                q = 2*k*th / sg**2 - 1                   #deg of freedom\n",
        "                if q<= -1:       #ensuring positivity of degrees of freedom\n",
        "                    return 1e10\n",
        "                u = c*np.exp(-k * dt) * r_t   # non-centrality parameter\n",
        "                v = c*r_t1                    # scaled next-step rate\n",
        "                if np.any(u <= 0) or np.any(v <= 0):   #log requires both postive\n",
        "                    return 1e10                        #numerical safety\n",
        "                ll = np.sum(\n",
        "                    np.log(c) - u - v\n",
        "                    + 0.5 * q * np.log(v / u)\n",
        "                    + ncx2.logpdf(2 * v, df=2 * q + 2, nc=2 * u)\n",
        "                )\n",
        "                return -ll   # we MINIMISE negative log-likelihood\n",
        "            except Exception:\n",
        "                return 1e10\n",
        "\n",
        "        res = minimize(neg_ll, [0.5, 0.025, 0.05], method=\"L-BFGS-B\",\n",
        "                       bounds=[(1e-4, 20),     #kappa\n",
        "                               (1e-4, 0.5),    #theta\n",
        "                               (1e-4, 2.0)])    #sigma\n",
        "        k_mle, th_mle, sg_mle = res.x\n",
        "        if verbose:\n",
        "            print(\n",
        "                f\"  MLE estimates --> \"\n",
        "                f\"κ={k_mle:.5f}, \"\n",
        "                f\"θ={th_mle:.6f}, \"\n",
        "                f\"σ={sg_mle:.5f}\"\n",
        "            )\n",
        "            print(\n",
        "                f\"  Feller condition satisfied: \"\n",
        "                f\"{2*k_mle*th_mle >= sg_mle**2}\"\n",
        "            )\n",
        "\n",
        "        return {\n",
        "            \"kappa\": k_mle,\n",
        "            \"theta\": th_mle,\n",
        "            \"sigma\": sg_mle,\n",
        "            \"res\": res\n",
        "        }\n",
        "\n",
        "print(\"   CIRModel class defined successfully!\")\n",
        "# print(\"   Methods available: .fit(), .yield_curve(), .mle_fit()\")\n"
      ]
    },
