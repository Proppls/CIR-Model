        "\n",
        "# print(train.shape)\n",
        "# print(train.isna().sum())\n",
        "\n",
        "#First 251 rows do not have enough data for a 252-day average, so they contain NaN values and must be removed\n",
        "train_2f = train.dropna(subset=[\"x_factor\", \"z_factor\"]).copy()\n",
        "\n",
        "print(f\"\\nRows available for 2-factor training: {len(train_2f):,}\")\n",
        "print(f\"Average level factor (x): {train_2f['x_factor'].mean()*100:.3f}%\")\n",
        "print(\n",
        "    f\"Average slope factor (z): {train_2f['z_factor'].mean()*100:.3f}% \"\n",
        "    f\"(Std Dev = {train_2f['z_factor'].std()*100:.3f}%)\"\n",
        ")\n",
        "\n",
        "cir_2f = TwoFactorCIR()\n",
        "cir_2f.fit(\n",
        "    x_arr      = train_2f[\"x_factor\"].values,\n",
